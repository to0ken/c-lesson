<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <DockPanel Background="#F0F0F0" LastChildFill="True">

           
            <StackPanel x:Name="LoginPanel" 
                    Width="250" Height="200"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="White" Margin="20">

                <TextBlock Text="Вход" FontSize="20" FontWeight="Bold" Margin="20" TextAlignment="Center"/>

                <TextBox Name="LoginBox" Height="30" Margin="10,0,10,10" Text="you"/>
                <PasswordBox Name="PassBox" Height="30" Margin="10,0,10,20" Password="123"/>

                <Button Content="Войти" Height="35" Margin="10,0,10,0" Click="Login_Click"/>
                <TextBlock Name="ErrorText" TextAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            
            <StackPanel Name="PhotoPanel" 
                    Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">

                <TextBlock Text="Добро пожаловать" FontSize="18" FontWeight="Bold"  Margin="15"/>


                <Image Source="" 
                   Width="400" Height="300"/>

                <Button Content="Выйти" Width="100" Height="30" Margin="0,15,0,0" Click="Logout_Click"/>
            </StackPanel>

        </DockPanel>


    </Grid>
</Window>
